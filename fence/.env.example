# Copy to .env. Never commit filled credentials.
# Cloud: create a key in https://ui.hindsight.vectorize.io > Connect.
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
# Local Docker: use http://localhost:8888; key may be empty on an unauthenticated server.
HINDSIGHT_BANK_ID=kaveri-pay
HINDSIGHT_TIMEOUT_SECONDS=15
HINDSIGHT_OPERATION_TIMEOUT_SECONDS=90
HINDSIGHT_MAX_ATTEMPTS=3
HINDSIGHT_RETRY_MIN_SECONDS=0.5
HINDSIGHT_RETRY_MAX_SECONDS=2
HINDSIGHT_POLL_INTERVAL_SECONDS=1

# Seeding checked-in data never calls Groq from Fence.
GROQ_API_KEY=
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=8
# Total attempts per model, including the initial request.
GROQ_MAX_ATTEMPTS=2

# Durable outcome submission queue; default: fence/.data/outcomes.sqlite3.
# Use a persistent disk path when deploying. This file contains proposal/feedback data.
# OUTCOME_QUEUE_PATH=/persistent/fence/outcomes.sqlite3
